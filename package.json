{
  "name": "dynamic-island",
  "version": "1.0.0",
  "description": "Windows Dynamic Island - Modern floating desktop hub",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "firebase": "^12.12.1",
    "loudness": "^0.4.2",
    "systeminformation": "^5.22.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.dynamicisland.app",
    "productName": "Dynamic Island",
    "asar": true,
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "modules/**/*",
      "src/**/*",
      "icon.ico",
      "icon.png",
      "node_modules/**/*",
      "!node_modules/electron",
      "!node_modules/electron-builder",
      "!node_modules/png-to-ico",
      "!node_modules/**/{test,tests,__tests__,spec,specs}/**",
      "!node_modules/**/*.{md,markdown,txt,TXT}",
      "!node_modules/**/{CHANGELOG,CHANGES,AUTHORS,CONTRIBUTORS,AUTHOR,HISTORY}*",
      "!node_modules/**/{.github,.gitlab,.editorconfig,.eslintrc*,.prettierrc*}",
      "!**/*.map",
      "!**/*.bak",
      "!**/*.bak2",
      "!**/debug.log"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*.ps1"
        ]
      }
    ]
  }
}
